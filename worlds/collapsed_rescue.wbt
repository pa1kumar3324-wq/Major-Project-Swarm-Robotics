  children [
    Shape { geometry Box { size 6 0.3 3 } }
  ]
  boundingObject Box { size 6 0.3 3 }
  physics Physics { density 2200 }
}

# =========================
# SCATTERED DEBRIS FIELD
# =========================

Solid {
  translation 15 0.5 -10
  children [ Shape { geometry Box { size 2 1 2 } } ]
  boundingObject Box { size 2 1 2 }
  physics Physics { density 2000 }
}

Solid {
  translation -15 0.5 12
  children [ Shape { geometry Box { size 3 1 1 } } ]
  boundingObject Box { size 3 1 1 }
  physics Physics { density 2000 }
}

Solid {
