# =========================
# HAZARDS AND ENVIRONMENTAL CHALLENGES
# =========================

# Unstable rubble pile (could collapse)
Solid {
  translation -8 1.5 12
  name "unstable_rubble"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.4 0.3 0.2
        roughness 1
        metalness 0
      }
      geometry Box { size 4 3 4 }
    }
  ]
  boundingObject Box { size 4 3 4 }
  physics Physics { density 1800 }
}

# Water pool (affects traction)
Solid {
  translation 20 0.05 -8
  name "water_pool"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.2 0.4 0.8
        transparency 0.3
        roughness 0.1
        metalness 0.1
      }
      geometry Box { size 6 0.1 6 }
    }
  ]
  boundingObject Box { size 6 0.1 6 }
  physics Physics { density 1000 }
}

# Smoke/dust cloud (visual obstacle)
Solid {
  translation 5 2 15
  name "dust_cloud"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.5 0.5 0.5
        transparency 0.7
        roughness 1
        metalness 0
      }
      geometry Sphere { radius 2 }
    }
  ]
  boundingObject Sphere { radius 2 }
  physics Physics { density 1 }  # Very light
}

# Narrow passage (requires precise navigation)
Solid {
  translation -18 1 2
  rotation 0 1 0 0.5
  children [
