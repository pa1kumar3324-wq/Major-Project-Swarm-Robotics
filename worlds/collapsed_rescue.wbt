}

# =========================
# VICTIMS (DIFFERENT SCENARIOS)
# =========================

# 1: Fully trapped under slab
Solid {
  translation 6 0.3 5
  name "victim_trapped"
  children [
    Shape {
      appearance PBRAppearance { baseColor 1 0 0 }
      geometry Sphere { radius 0.3 }
    }
  ]
  boundingObject Sphere { radius 0.3 }
  physics Physics { density 1000 }
}

# 2: In tunnel (low clearance)
