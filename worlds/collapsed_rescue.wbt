#VRML_SIM R2023b utf8

WorldInfo {
  basicTimeStep 32
  gravity 0 -9.81 0
}

Viewpoint {
  position 20 25 30
  orientation -0.4 0.9 0.1 2.3
}

TexturedBackground {}
TexturedBackgroundLight {}

# =========================
# GROUND (BIGGER AREA)
# =========================
Solid {
  translation 0 0 0
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.25 0.25 0.25
        roughness 1
      }
      geometry Box {
        size 80 0.2 80
      }
    }
  ]
  boundingObject Box { size 80 0.2 80 }
  physics Physics { mass 0 }
}

# =========================
# BUILDING 1 (COLLAPSED FLOORS)
# =========================

# Floor slab tilted
Solid {
  translation 5 2 5
  rotation 0 0 1 0.4
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.6 0.6 0.6 }
      geometry Box { size 10 0.5 8 }
    }
  ]
  boundingObject Box { size 10 0.5 8 }
  physics Physics { density 2400 }
}

# Second slab fallen
Solid {
  translation 8 4 6
  rotation 1 0 0 0.6
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.55 0.55 0.55 }
      geometry Box { size 8 0.5 6 }
    }
  ]
  boundingObject Box { size 8 0.5 6 }
  physics Physics { density 2400 }
}

# Vertical broken wall
