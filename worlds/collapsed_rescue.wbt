  translation 3 2 8
  rotation 0 1 0 0.3
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.7 0.7 0.7 }
      geometry Box { size 0.5 4 6 }
    }
  ]
  boundingObject Box { size 0.5 4 6 }
  physics Physics { density 2200 }
}

